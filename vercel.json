{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "regions": ["gru1"],
  "functions": {
    "api/mcp.js": {
      "maxDuration": 120,
      "includeFiles": "{dist/**,node_modules/bpmn-to-image/**,node_modules/bpmn-js/dist/bpmn-modeler.development.js,node_modules/bpmnlint/**,node_modules/bpmnlint-plugin-camunda-compat/**}"
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp?route=mcp"
    },
    {
      "source": "/health",
      "destination": "/api/mcp?route=health"
    },
    {
      "source": "/(.*)",
      "destination": "/api/mcp?route=notfound"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
