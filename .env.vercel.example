# Variáveis do projeto na Vercel (Project → Settings → Environment Variables).
# Não preencha segredos neste arquivo: ele é só a referência comentada.
# Para rodar o modo Vercel localmente, copie para .env.vercel (no .gitignore).

# ── Obrigatório ──────────────────────────────────────────────────────────────
# Tokens aceitos em "Authorization: Bearer <token>", separados por vírgula,
# cada um com no mínimo 32 caracteres (openssl rand -hex 32). Cada token tem
# seus próprios diagramas: quem usa outro token não os vê.
# Vazio ou curto = toda requisição responde 500 e o log da função diz por quê.
MCP_AUTH_TOKENS=

# ── Preenchidas pela Vercel ao conectar o Upstash Redis (Storage → Upstash) ──
# Não digite à mão: a integração do Marketplace injeta estas duas.
# Sem elas, toda requisição responde 500 (de propósito: sem Redis os
# diagramas sumiriam entre uma chamada e outra).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Opcionais (valores abaixo são os defaults) ───────────────────────────────
# Diagramas guardados por token; ao estourar, o mais antigo é apagado.
BPMN_MCP_MAX_DIAGRAMS=20
# Dias sem uso até um diagrama expirar no Redis.
BPMN_MCP_DIAGRAM_TTL_DAYS=7
# Origens de navegador autorizadas (clientes de desktop/CLI não precisam).
MCP_ALLOWED_ORIGINS=
# full = todas as ferramentas; core = só as 10 mais usadas.
BPMN_MCP_TOOLS=full

# ── Só para rodar localmente sem Redis (um processo só) ──────────────────────
# BPMN_MCP_STORE=memory
