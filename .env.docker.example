# Variáveis do docker-compose.yml. Copie para .env.docker (já está no
# .gitignore) e preencha. Use:  docker compose --env-file .env.docker up -d
#
# Por que .env.docker e não .env: o .env costuma ir parar no git por engano em
# repositórios vindos de outras ferramentas; um nome próprio, ignorado pelo git,
# evita que o token de produção seja versionado.

# ── Obrigatório ──────────────────────────────────────────────────────────────
# Tokens aceitos no cabeçalho "Authorization: Bearer <token>", separados por
# vírgula (um por usuário/equipe, ou dois durante uma troca de token).
# Cada um com no mínimo 32 caracteres. Gere com:  openssl rand -hex 32
# Vazio ou curto = o app se recusa a subir, de propósito.
MCP_AUTH_TOKENS=

# ── Porta ────────────────────────────────────────────────────────────────────
# Porta do HOST em que o nginx fica exposto (dentro do container é 8080).
HTTP_PORT=8080

# ── Opcionais (os valores abaixo são os defaults) ────────────────────────────
# Origens de navegador autorizadas a chamar /mcp (ex.: https://app.fgv.br).
# Vazio = nenhuma; clientes MCP de desktop/CLI não mandam Origin e funcionam.
MCP_ALLOWED_ORIGINS=
# Sessões MCP abertas ao mesmo tempo (cada uma guarda seus diagramas em memória).
MCP_MAX_SESSIONS=50
# Minutos sem uso até a sessão (e seus diagramas) ser descartada.
MCP_SESSION_IDLE_MINUTES=30
# Tamanho máximo do corpo da requisição, em bytes (4 MB). Se mudar, mude
# também client_max_body_size em deploy/nginx/nginx.conf.
MCP_MAX_BODY_BYTES=4194304
# Requisições POST processadas em paralelo (o trabalho é CPU: jsdom/bpmn-js).
MCP_MAX_CONCURRENT_REQUESTS=8
# Diagramas por sessão; ao estourar, o mais antigo é descartado.
BPMN_MCP_MAX_DIAGRAMS=20
# full = todas as ferramentas; core = só as 10 mais usadas (agentes com pouco contexto).
BPMN_MCP_TOOLS=full

# Tag das imagens construídas pelo compose.
IMAGE_TAG=latest
